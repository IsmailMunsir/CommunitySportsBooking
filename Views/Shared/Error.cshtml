@model CommunitySportsBooking.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container section text-center">
    <div class="empty-state">
        <div class="icon">⚠</div>
        <h1>Something went wrong</h1>
        <p>An unexpected error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-16">Back to Home</a>
    </div>
</div>