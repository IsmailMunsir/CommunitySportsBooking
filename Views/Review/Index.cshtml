@model List<Review>
@{
    ViewData["Title"] = "Reviews";
}

<section class="section container">
    <div class="section-heading">
        <span class="kicker">Community feedback</span>
        <h1>Facility reviews</h1>
        <p class="text-muted">Open to everyone — see what members think before you book.</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="icon">⭐</div>
            <p>No reviews have been submitted yet.</p>
        </div>
    }
    else
    {
        <div class="grid grid-3">
            @foreach (var review in Model)
            {
                <div class="card card-body">
                    <div class="flex justify-between items-center">
                        <span class="badge badge-blue">@review.FacilityName</span>
                        <span class="rating-star">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
                    </div>
                    <p class="mt-8">"@review.Comment"</p>
                    <span class="small text-muted">— @review.MemberName · @review.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
            }
        </div>
    }
</section>