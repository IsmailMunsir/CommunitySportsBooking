@model CreateReviewViewModel
@{
    ViewData["Title"] = "Leave a Review";
}

<section class="section container">
    <div class="form-card">
        <div class="text-center mb-16">
            <span class="badge badge-blue">Review</span>
            <h1 style="font-size:1.5rem">@Model.FacilityName</h1>
            <p class="text-muted small">Tell other members about your experience.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-controller="Review" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="FacilityId" />
            <input type="hidden" asp-for="FacilityName" />
            <input type="hidden" asp-for="BookingId" />

            <div class="form-group">
                <label asp-for="Rating">Rating</label>
                <select asp-for="Rating">
                    <option value="5">★★★★★ — Excellent</option>
                    <option value="4">★★★★☆ — Good</option>
                    <option value="3">★★★☆☆ — Average</option>
                    <option value="2">★★☆☆☆ — Poor</option>
                    <option value="1">★☆☆☆☆ — Very poor</option>
                </select>
                <span asp-validation-for="Rating" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Comment">Your review</label>
                <textarea asp-for="Comment" placeholder="How was the facility's condition, amenities, and your overall experience?"></textarea>
                <span asp-validation-for="Comment" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Submit Review</button>
        </form>
    </div>
</section>