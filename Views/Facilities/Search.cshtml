@model FacilitySearchViewModel
@{
    ViewData["Title"] = "Find a Facility";
}

<section class="section container">
    <div class="section-heading">
        <span class="kicker">Members</span>
        <h1>Search sports facilities</h1>
        <p class="text-muted">Filter by type, location, date and time to find an available slot.</p>
    </div>

    <div class="card card-body mb-16">
        <form asp-controller="Facilities" asp-action="Search" method="get" class="grid grid-2" style="align-items:end;">
            <div class="form-group">
                <label for="facilityType">Facility type</label>
                <select id="facilityType" name="facilityType">
                    <option value="">Any type</option>
                    @foreach (var type in FacilitySearchViewModel.FacilityTypes)
                    {
                        if (Model.FacilityType == type)
                        {
                            <option value="@type" selected>@type</option>
                        }
                        else
                        {
                            <option value="@type">@type</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="location">Location</label>
                <input id="location" name="location" value="@Model.Location" placeholder="e.g. Riverside, Downtown" />
            </div>
            <div class="form-group">
                <label for="date">Date</label>
                <input id="date" type="date" name="date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="form-group">
                <label for="time">Preferred time</label>
                <input id="time" type="time" name="time" value="@Model.Time" />
            </div>
            <div class="form-group" style="grid-column: span 2;">
                <button type="submit" class="btn btn-primary">Search Facilities</button>
                <a asp-controller="Facilities" asp-action="Search" class="btn btn-ghost">Clear</a>
            </div>
        </form>
    </div>

    @if (Model.Results.Count == 0)
    {
        <div class="empty-state">
            <div class="icon">🔍</div>
            <p>No facilities matched your search. Try a different type or location.</p>
        </div>
    }
    else
    {
        <div class="grid grid-3">
            @foreach (var facility in Model.Results)
            {
                <div class="card card-hover facility-card">
                    <div class="facility-image-placeholder">@facility.Type</div>
                    <div class="card-body">
                        <span class="badge badge-blue">@facility.Type</span>
                        <h3 class="mt-8" style="font-size:1.1rem">@facility.Name</h3>
                        <p class="small">📍 @facility.Location</p>
                        <p class="small text-muted">🕒 @facility.OpeningTime – @facility.ClosingTime</p>
                        <div class="flex justify-between items-center mt-16">
                            <span class="price-tag">$@facility.PricePerHour.ToString("0.00")<span class="text-muted small">/hr</span></span>
                            <a asp-controller="Facilities" asp-action="Details" asp-route-id="@facility.Id" class="btn btn-outline btn-sm">View & Book</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>