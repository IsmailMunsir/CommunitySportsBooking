@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<section class="section container">
    <div class="form-card">
        <div class="text-center mb-16">
            <span class="badge badge-blue">Members</span>
            <h1 style="font-size:1.6rem">Welcome back</h1>
            <p class="text-muted small">Sign in to search, book and review facilities.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Sign In</button>
        </form>

        <p class="text-center small mt-16">
            Don't have an account? <a asp-controller="Account" asp-action="Register">Register here</a>
        </p>
        <p class="text-center small text-muted">
            Demo login: <code>demo@sportsbooking.local</code> / <code>Demo@123</code>
        </p>
    </div>
</section>