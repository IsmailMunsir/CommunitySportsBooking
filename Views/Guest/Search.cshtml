@model FacilitySearchViewModel
@{
    ViewData["Title"] = "Browse Facilities";
}

<section class="section container">
    <div class="section-heading">
        <span class="kicker">Guest access</span>
        <h1>Browse sports facilities</h1>
        <p class="text-muted">You're viewing a limited preview. <a asp-controller="Account" asp-action="Register">Sign in or register</a> for full booking details and availability.</p>
    </div>

    <div class="card card-body mb-16">
        <form asp-controller="Guest" asp-action="Search" method="get" class="grid grid-2" style="align-items:end;">
            <div class="form-group">
                <label for="facilityType">Facility type</label>
                <select id="facilityType" name="facilityType">
                    <option value="">Any type</option>
                    @foreach (var type in FacilitySearchViewModel.FacilityTypes)
                    {
                        if (Model.FacilityType == type)
                        {
                            <option value="@type" selected>@type</option>
                        }
                        else
                        {
                            <option value="@type">@type</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="location">Location</label>
                <input id="location" name="location" value="@Model.Location" placeholder="e.g. Riverside, Downtown" />
            </div>
            <div class="form-group" style="grid-column: span 2;">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-controller="Guest" asp-action="Search" class="btn btn-ghost">Clear</a>
            </div>
        </form>
    </div>

    @if (Model.Results.Count == 0)
    {
        <div class="empty-state">
            <div class="icon">🔍</div>
            <p>No facilities matched your search.</p>
        </div>
    }
    else
    {
        <div class="grid grid-3">
            @foreach (var facility in Model.Results)
            {
                <div class="card facility-card">
                    <div class="facility-image-placeholder">@facility.Type</div>
                    <div class="card-body">
                        <span class="badge badge-blue">@facility.Type</span>
                        <h3 class="mt-8" style="font-size:1.1rem">@facility.Name</h3>
                        <p class="small">📍 @facility.Location</p>
                        <p class="small text-muted">General availability: @facility.OpeningTime – @facility.ClosingTime</p>
                        <div class="mt-16">
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline btn-sm btn-block">Sign in to book &amp; see pricing</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>