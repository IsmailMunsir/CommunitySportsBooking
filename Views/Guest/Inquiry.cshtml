@model InquiryViewModel
@{
    ViewData["Title"] = "Send an Inquiry";
}

<section class="section container">
    <div class="form-card">
        <div class="text-center mb-16">
            <span class="badge">Contact</span>
            <h1 style="font-size:1.6rem">Send us an inquiry</h1>
            <p class="text-muted small">Questions about programs, membership, or a specific facility? Reach out below.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-controller="Guest" asp-action="Inquiry" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" placeholder="Your name" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Subject">Subject</label>
                <input asp-for="Subject" placeholder="e.g. Membership question" />
                <span asp-validation-for="Subject" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Message">Message</label>
                <textarea asp-for="Message" placeholder="How can we help?"></textarea>
                <span asp-validation-for="Message" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Send Inquiry</button>
        </form>
    </div>
</section>