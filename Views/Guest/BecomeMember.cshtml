@model BecomeMemberViewModel
@{
    ViewData["Title"] = "Become a Member";
}

<section class="section container">
    <div class="form-card">
        <div class="text-center mb-16">
            <span class="badge">Guests</span>
            <h1 style="font-size:1.6rem">Become a member</h1>
            <p class="text-muted small">Just your name and email to get started — you can complete your profile later.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-controller="Guest" asp-action="BecomeMember" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="FullName">Full name</label>
                <input asp-for="FullName" placeholder="Jane Perera" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-teal btn-block">Create My Account</button>
        </form>

        <p class="text-center small mt-16">
            Want to add your sports preferences now instead? <a asp-controller="Account" asp-action="Register">Full registration</a>
        </p>
    </div>
</section>