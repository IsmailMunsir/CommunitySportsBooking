@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    var sports = ViewBag.Sports as string[] ?? RegisterViewModel.AvailableSports;
}

<section class="section container">
    <div class="form-card form-card-wide">
        <div class="text-center mb-16">
            <span class="badge badge-blue">New Member</span>
            <h1 style="font-size:1.6rem">Create your account</h1>
            <p class="text-muted small">Tell us a bit about yourself so we can personalize your facility recommendations.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="grid grid-2">
                <div class="form-group">
                    <label asp-for="FullName">Full name</label>
                    <input asp-for="FullName" placeholder="Jane Perera" />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
            </div>

            <div class="grid grid-2">
                <div class="form-group">
                    <label asp-for="Phone">Contact number</label>
                    <input asp-for="Phone" placeholder="077 123 4567" />
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address">Address</label>
                    <input asp-for="Address" placeholder="123 Community Lane" />
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label>Preferred sports</label>
                <div class="checkbox-grid">
                    @foreach (var sport in sports)
                    {
                        <label class="checkbox-pill">
                            <input type="checkbox" name="PreferredSports" value="@sport" />
                            @sport
                        </label>
                    }
                </div>
                <span asp-validation-for="PreferredSports" class="field-error"></span>
            </div>

            <div class="grid grid-2">
                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" placeholder="At least 6 characters" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Repeat password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block mt-8">Create Account</button>
        </form>

        <p class="text-center small mt-16">
            Already a member? <a asp-controller="Account" asp-action="Login">Sign in</a>
        </p>
    </div>
</section>